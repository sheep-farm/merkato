{
    "id" : "com.ekonomikas.merkato",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "49",
    "sdk" : "org.gnome.Sdk",
    "sdk-extensions" : [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command" : "merkato",
    "finish-args" : [
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland"
    ],
    "build-options" : {
        "append-path" : "/usr/lib/sdk/rust-stable/bin",
        "env" : {
            "RUST_BACKTRACE" : "1",
            "RUST_LOG" : "merkato=debug",
            "CARGO_NET_OFFLINE" : "true"
        }
    },
    "cleanup" : [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules" : [
        {
            "name" : "merkato",
            "builddir" : true,
            "buildsystem" : "meson",
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://github.com/sheep-farm/merkato.git",
                    "tag" : "v0.3.0"
                },
                "cargo-sources.json",
                {
                    "type" : "shell",
                    "commands" : [
                        "mkdir -p .cargo",
                        "cp -vf cargo/config .cargo/config.toml"
                    ]
                }
            ],
            "config-opts" : [
                "--libdir=lib"
            ]
        }
    ]
}
